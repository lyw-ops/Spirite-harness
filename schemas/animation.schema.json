{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lyw-ops/Spirite-harness/schemas/animation.schema.json",
  "title": "Sprite Harness Animation Specification",
  "description": "Version 1 manifest for a frame-based sprite animation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "character",
    "state",
    "canvas",
    "anchor",
    "playback",
    "frames"
  ],
  "properties": {
    "version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "character": { "$ref": "#/$defs/identifier" },
    "state": { "$ref": "#/$defs/identifier" },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "background"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "background": { "type": "string", "minLength": 1 }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "playback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fps", "loop"],
      "properties": {
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "loop": { "type": "boolean" }
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "duration"],
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "duration": { "type": "number", "exclusiveMinimum": 0 },
          "action": {
            "type": "string",
            "description": "Human/agent metadata; runtime playback must not interpret it."
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }
      }
    }
  }
}

