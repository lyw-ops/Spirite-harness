{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lyw-ops/Spirite-harness/schemas/generation-spec.schema.json",
  "title": "Sprite Harness generation-spec v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "generation_version": {
      "type": "integer",
      "const": 1
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object"
        },
        "seed_policy": {
          "enum": [
            "required",
            "allow_unsupported"
          ]
        }
      },
      "required": [
        "id",
        "version",
        "model",
        "parameters",
        "seed_policy"
      ]
    },
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "frames": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 1,
            "maxItems": 65536,
            "uniqueItems": true
          },
          "instruction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32000
          }
        },
        "required": [
          "id",
          "target",
          "frames",
          "instruction"
        ]
      },
      "minItems": 1,
      "maxItems": 65536
    }
  },
  "required": [
    "generation_version",
    "request_id",
    "adapter",
    "requests"
  ]
}
