{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lyw-ops/Spirite-harness/schemas/frame-plan.schema.json",
  "title": "Sprite Harness Frame Plan",
  "description": "Version 1 deterministic expansion of an Animation Plan: one entry per frame with concrete sampled transform values. Produced by 'sprite-harness plan'; consumed by renderers and validators.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "frame_plan_version",
    "animation_id",
    "generated_by",
    "plan_digest",
    "source",
    "playback",
    "canvas",
    "anchor",
    "reduced_motion",
    "frames"
  ],
  "properties": {
    "frame_plan_version": { "const": 1 },
    "animation_id": { "type": "string", "minLength": 1 },
    "generated_by": { "type": "string", "minLength": 1 },
    "plan_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Digest of the canonical normalized plan; binds this frame plan to plan.json."
    },
    "source": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "width", "height"],
          "properties": {
            "path": {
              "type": "string",
              "description": "Source image path relative to the build directory when possible."
            },
            "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "playback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fps", "frame_count", "loop"],
      "properties": {
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "frame_count": { "type": "integer", "minimum": 1 },
        "loop": { "type": "boolean" }
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "background"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "background": { "type": "string", "minLength": 1 }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "x", "y"],
      "properties": {
        "type": { "enum": ["bottom_center", "center", "custom"] },
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "description": "Anchor with coordinates fully resolved."
    },
    "reduced_motion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["full", "hold_first_frame"] }
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/frame" }
    }
  },
  "$defs": {
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "file", "time_s", "transforms", "offset", "events"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "file": {
          "type": "string",
          "pattern": "^frames/frame_[0-9]{3,}\\.png$",
          "description": "Expected frame filename relative to the build directory."
        },
        "time_s": { "type": "number", "minimum": 0 },
        "transforms": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["track_id", "target", "motion", "unit", "value"],
            "properties": {
              "track_id": { "type": "string", "minLength": 1 },
              "target": { "type": "string", "minLength": 1 },
              "motion": {
                "enum": ["translate_x", "translate_y", "rotate", "scale", "opacity"]
              },
              "unit": { "enum": ["px", "deg", "ratio"] },
              "value": {
                "type": "number",
                "description": "Sampled delta. Effective scale/opacity is 1 + value."
              }
            }
          }
        },
        "offset": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "number", "description": "Aggregate translation in px; positive is rightward." },
            "y": { "type": "number", "description": "Aggregate translation in px; positive is downward." }
          }
        },
        "events": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Sorted ids of plan events active on this frame."
        }
      }
    }
  }
}
