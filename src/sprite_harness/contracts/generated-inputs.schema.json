{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lyw-ops/Spirite-harness/schemas/generated-inputs.schema.json",
  "title": "Sprite Harness generated-inputs v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "accepted_version": {
      "type": "integer",
      "const": 1
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "request_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "response_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "spec_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "seed_supported": {
      "type": "boolean"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
          },
          "candidate_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "frames": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 1,
            "maxItems": 65536,
            "uniqueItems": true
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "rgba_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16384
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16384
          }
        },
        "required": [
          "id",
          "candidate_id",
          "target",
          "frames",
          "file",
          "sha256",
          "rgba_digest",
          "width",
          "height"
        ]
      },
      "minItems": 1,
      "maxItems": 65536
    },
    "spec_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  },
  "required": [
    "accepted_version",
    "plan_digest",
    "request_digest",
    "response_digest",
    "spec_digest",
    "seed_supported",
    "inputs",
    "spec_source"
  ]
}
